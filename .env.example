# Barrio Logan Guest Concierge — environment variables
# Copy this file to .env.local and fill in values. NEVER commit .env.local.

# ---- Model provider selection ----------------------------------------
# "ollama"     → use a local Ollama instance (default for dev)
# "anthropic"  → use Claude Haiku via Anthropic API (recommended for prod)
MODEL_PROVIDER=ollama

# ---- Ollama (dev) -------------------------------------------------------
# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model to use. Any model pulled via `ollama pull <model>` works.
# Recommended lightweight option: llama3.2 (2 GB), mistral, or phi3.
OLLAMA_MODEL=llama3.2

# ---- Anthropic / Claude Haiku (prod) ------------------------------------
# Uncomment and set ANTHROPIC_API_KEY when deploying to production.
# Also set MODEL_PROVIDER=anthropic in your deployment environment.
# NEVER commit a real API key — set it as a deployment secret.
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
