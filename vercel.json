{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "nextjs",

  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 30
    }
  },

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
