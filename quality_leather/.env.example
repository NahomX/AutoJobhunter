# --- Gemini (primary preview engine) -------------------------------------
# Google AI Studio API key — get one at https://aistudio.google.com/apikey
# Powers garment analysis (Gemini multimodal) + the leather turntable views
# (Nano Banana Pro / gemini-3-pro-image-preview).
# Leave UNSET to run in mock mode: the 4 uploaded photos become the turntable
# frames so the whole upload → spin flow works with no external calls.
GEMINI_API_KEY=

# --- Meshy (optional background 3D mesh, hybrid mode) ---------------------
# Meshy AI key — get one at https://www.meshy.ai/
# Optional. When set AND a job requests a mesh, a true 3D GLB is generated in
# the background for the tailor handoff and shown in a "3D mesh" tab.
# Leave unset to skip the mesh entirely (turntable-only).
MESHY_API_KEY=

# --- Deployment -----------------------------------------------------------
# Public base URL used to build absolute photo URLs for the Meshy API.
# Change to your deployed URL in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
